# ─── App ──────────────────────────────────────────────────
ENVIRONMENT=development
APP_NAME="Plataforma Professora"
APP_VERSION=1.0.0
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── Banco de Dados ────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://plataforma:plataforma_secret@localhost:5432/plataforma_dev
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ─── Redis ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── CORS ─────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:3000","https://seudominio.com.br"]

# ─── AWS ──────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=plataforma-professora-files
AWS_CLOUDFRONT_URL=https://xxxxxx.cloudfront.net

# ─── SES (E-mail) ─────────────────────────────────────────
AWS_SES_SENDER=contato@seudominio.com.br
AWS_SES_REGION=us-east-1

# ─── IA ───────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENAI_API_KEY=sk-your-key-here
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-4-6

# ─── Pagamentos ───────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your-stripe-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
PAGARME_API_KEY=ak_test_your-pagarme-key

# ─── WhatsApp (via N8N) ───────────────────────────────────
N8N_WEBHOOK_URL=http://localhost:5678/webhook
N8N_API_KEY=your-n8n-api-key

# ─── Google Calendar ──────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── Zoom ─────────────────────────────────────────────────
ZOOM_API_KEY=your-zoom-api-key
ZOOM_API_SECRET=your-zoom-api-secret

# ─── Frontend ─────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
